{
  "name": "focusos-backend",
  "version": "1.0.0",
  "description": "Bun & Supabase PostgreSQL Backend for FocusOS Productivity Dashboard",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "~/.bun/bin/bun run src/server.ts",
    "dev": "~/.bun/bin/bun --watch src/server.ts",
    "db:init": "~/.bun/bin/bun run src/init-db.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14"
  }
}
